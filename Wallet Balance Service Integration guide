## Go Structs for Response Handling

```go
package main

import (
    "encoding/json"
    "fmt"
    "net/http"
    "time"
)

// StandardResponse represents the top-level API response
type StandardResponse struct {
    Success bool        `json:"success"`
    Data    *BalanceData `json:"data,omitempty"`
    Errors  []string    `json:"errors,omitempty"`
}

// BalanceData represents the balance information
type BalanceData struct {
    Ticker        string      `json:"Ticker"`
    Amount        string      `json:"Amount"`          // Always returned as string to preserve precision
    WalletId      string      `json:"WalletId"`        // Format: "bitwave-wallet-id-{first8chars}"
    RemoteWalletId string     `json:"RemoteWalletId"`  // Original wallet address
    BlockId       string      `json:"BlockId"`         // Block number or "0"
    TimestampSEC  string      `json:"TimestampSEC"`    // Unix timestamp as string
    RawMetadata   RawMetadata `json:"RawMetadata"`
}

// RawMetadata contains source information and raw API response
type RawMetadata struct {
    Source      string      `json:"source"`       // e.g., "Etherscan API", "Bitcoin Blockchain.info API"
    Chain       string      `json:"chain"`        // Chain name, capitalized
    RawResponse interface{} `json:"raw_response"` // Original API response (varies by provider)
}
```

## Example Usage in Go

```go
package main

import (
    "encoding/json"
    "fmt"
    "net/http"
    "strconv"
    "time"
)

const BaseURL = "https://walletbalanceservice-455488113475.us-central1.run.app"

// WalletBalanceClient handles API calls to the wallet balance service
type WalletBalanceClient struct {
    httpClient *http.Client
    baseURL    string
}

// NewWalletBalanceClient creates a new client instance
func NewWalletBalanceClient() *WalletBalanceClient {
    return &WalletBalanceClient{
        httpClient: &http.Client{Timeout: 30 * time.Second},
        baseURL:    BaseURL,
    }
}

// GetBalance fetches balance for a given chain and address
func (c *WalletBalanceClient) GetBalance(chain, address string) (*BalanceData, error) {
    url := fmt.Sprintf("%s/api/v1/chains/%s/addresses/%s/balance", c.baseURL, chain, address)
    
    resp, err := c.httpClient.Get(url)
    if err != nil {
        return nil, fmt.Errorf("HTTP request failed: %w", err)
    }
    defer resp.Body.Close()
    
    var response StandardResponse
    if err := json.NewDecoder(resp.Body).Decode(&response); err != nil {
        return nil, fmt.Errorf("failed to decode response: %w", err)
    }
    
    if !response.Success {
        return nil, fmt.Errorf("API returned error: %v", response.Errors)
    }
    
    return response.Data, nil
}

// GetTokenBalance fetches ERC-20/BEP-20 token balance (for EVM chains only)
func (c *WalletBalanceClient) GetTokenBalance(chain, address, tokenContract string) (*BalanceData, error) {
    url := fmt.Sprintf("%s/api/v1/chains/%s/addresses/%s/balance?type=token&contractaddress=%s", 
        c.baseURL, chain, address, tokenContract)
    
    resp, err := c.httpClient.Get(url)
    if err != nil {
        return nil, fmt.Errorf("HTTP request failed: %w", err)
    }
    defer resp.Body.Close()
    
    var response StandardResponse
    if err := json.NewDecoder(resp.Body).Decode(&response); err != nil {
        return nil, fmt.Errorf("failed to decode response: %w", err)
    }
    
    if !response.Success {
        return nil, fmt.Errorf("API returned error: %v", response.Errors)
    }
    
    return response.Data, nil
}

// Helper function to convert balance string to float64
func (b *BalanceData) GetAmountFloat() (float64, error) {
    return strconv.ParseFloat(b.Amount, 64)
}

// Helper function to get timestamp as time.Time
func (b *BalanceData) GetTimestamp() (time.Time, error) {
    timestamp, err := strconv.ParseInt(b.TimestampSEC, 10, 64)
    if err != nil {
        return time.Time{}, err
    }
    return time.Unix(timestamp, 0), nil
}
```

